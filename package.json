{
  "name": "@local/dsh-mesh",
  "version": "0.2.0",
  "private": true,
  "description": "个人版 DSH Web：WireGuard 成员发现、成员切换（gate cookie）、源码级多平台离线构建。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "wireguard",
    "gateway",
    "build",
    "offline"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "code",
    "build",
    "docs",
    "start-interop.sh",
    "install-interop-service.sh",
    "uninstall-interop-service.sh",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:package": "node code/build/cli.mjs build",
    "plan:package": "node code/build/cli.mjs plan",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.wireguard.json --noEmit",
    "test": "node --test \"test/*.test.mjs\"",
    "test:wireguard": "node --test --import tsx \"test/wireguard/*.test.ts\"",
    "build:control": "node scripts/build.mjs control"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "devDependencies": {
    "@ant-design/icons": "^5.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "antd": "^5.27.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
